rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Règle générale pour les photos de profil
    match /profiles/{userId}/{allPaths=**} {
      // Tout utilisateur connecté peut lire les photos de profil
      allow read: if request.auth != null;
      
      // Seul le propriétaire peut uploader sa propre photo
      // Limitation à 5MB et uniquement des images
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
                   
      // Seul le propriétaire peut supprimer ses photos
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
