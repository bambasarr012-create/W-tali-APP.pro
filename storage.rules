rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Règle générale pour les photos de profil
    match /profiles/{userId}/{fileName} {
      // Tout utilisateur connecté peut lire les photos de profil
      allow read: if request.auth != null;
      
      // Seul le propriétaire peut uploader et supprimer
      allow write, delete: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Règle pour les messages vocaux
    match /voice-messages/{chatId}/{fileName} {
      allow read: if request.auth != null && chatId.matches('.*' + request.auth.uid + '.*');
      allow write: if request.auth != null 
                   && chatId.matches('.*' + request.auth.uid + '.*')
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');
    }
    
    // Tout le reste refusé
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
