rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == "bambasarr012@gmail.com"
        && request.auth.token.email_verified == true;
    }

    function isTester() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          "bambasarr012@gmail.com",
          "wetalidiaspora@gmail.com",
          "khdmsamu@gmail.com",
          "khadimsarr54@gmail.com"
        ];
    }

    // A passer a false le jour du lancement
    function prelaunchActive() { return true; }

    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    function canUseApp() { return signedIn() && (!prelaunchActive() || isTester() || isAdmin()); }

    function adminFieldsAreDefaults(d) {
      return d.get('suspended', false) == false
        && d.get('hidden', false) == false
        && d.get('verified', false) == false
        && d.get('isPremium', false) == false
        && d.get('subscriptionTier', null) == null
        && d.get('abonnementFin', null) == null
        && d.get('abonnementStatut', 'none') == 'none'
        && d.get('profileStatus', 'pending') == 'pending'
        && d.get('role', 'user') == 'user';
    }

    // 18 ans = 6575 jours (annees bissextiles incluses)
    function isAdultBirthDate(d) {
      return d is timestamp && d <= request.time - duration.value(6575, 'd');
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || canUseApp();

      allow create: if isOwner(userId)
        && (!prelaunchActive() || isTester())
        && request.resource.data.age is number
        && request.resource.data.age >= 18
        && adminFieldsAreDefaults(request.resource.data);

      allow update: if isAdmin() || (
        isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
             'suspended', 'hidden', 'verified', 'isPremium', 'subscriptionTier',
             'abonnementStatut', 'abonnementFin', 'role'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['profileStatus'])
            || request.resource.data.profileStatus == 'pending')
        && request.resource.data.get('age', 18) >= 18
      );

      allow delete: if isOwner(userId) || isAdmin();

      match /private/{docId} {
        allow read, delete: if isOwner(userId) || isAdmin();
        allow create, update: if (isOwner(userId) || isAdmin())
          && (request.resource.data.get('birthDate', null) == null
              || isAdultBirthDate(request.resource.data.birthDate));
      }
    }

    match /requests/{requestId} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId);
      allow create: if canUseApp()
        && request.auth.uid == request.resource.data.fromUserId
        && request.resource.data.toUserId != request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && request.auth.uid == resource.data.toUserId
        && request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.toUserId == resource.data.toUserId;
      allow delete: if signedIn()
        && (request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId);
    }

    match /matches/{matchId} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if canUseApp()
        && request.auth.uid in request.resource.data.users
        && request.resource.data.users.size() == 2;
      allow update, delete: if signedIn() && request.auth.uid in resource.data.users;
    }

    match /chats/{chatId} {
      allow read, write: if signedIn() && chatId.matches('.*' + request.auth.uid + '.*');
      match /messages/{messageId} {
        allow read, write: if signedIn() && chatId.matches('.*' + request.auth.uid + '.*');
      }
    }

    match /notifications/{notifId} {
      allow read, update, delete: if signedIn() && request.auth.uid == resource.data.userId;
      allow create: if canUseApp();
    }

    match /favorites/{favoriteId} {
      allow read, update, delete: if signedIn() && request.auth.uid == resource.data.userId;
      allow create: if canUseApp() && request.auth.uid == request.resource.data.userId;
    }

    match /visits/{visitId} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.visitedUserId || request.auth.uid == resource.data.visitorId);
      allow create, update: if canUseApp() && request.auth.uid == request.resource.data.visitorId;
    }

    match /reports/{reportId} {
      allow create: if canUseApp() && request.auth.uid == request.resource.data.reporterId;
      allow read, update, delete: if isAdmin();
    }

    match /waitlist/{docId} {
      allow create: if
        request.resource.data.keys().hasOnly(['firstName', 'email', 'country', 'city', 'consent', 'createdAt'])
        && request.resource.data.keys().hasAll(['firstName', 'email', 'country', 'city', 'consent', 'createdAt'])
        && docId == request.resource.data.email
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 50
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@]+@[^@]+[.][^@]+$')
        && request.resource.data.country is string
        && request.resource.data.country.size() > 0
        && request.resource.data.country.size() <= 100
        && request.resource.data.city is string
        && request.resource.data.city.size() > 0
        && request.resource.data.city.size() <= 100
        && request.resource.data.consent == true
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
