rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profils utilisateurs
    match /users/{userId} {
      // Tout le monde peut lire les profils pour le matching
      allow read: if request.auth != null;
      // Seul l'utilisateur peut créer ou modifier son propre profil, l'admin peut aussi modifier (pour suspendre)
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == "bambasarr012@gmail.com");
    }

    // Demandes (Requests)
    match /requests/{requestId} {
      // On peut lire une demande si on est l'expéditeur ou le destinataire
      allow read: if request.auth != null && (request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId);
      // On peut créer une demande si on est l'expéditeur
      allow create: if request.auth != null && request.auth.uid == request.resource.data.fromUserId;
      // Seul le destinataire peut modifier le statut (accepter/refuser)
      allow update: if request.auth != null && request.auth.uid == resource.data.toUserId;
      // On peut supprimer sa propre demande
      allow delete: if request.auth != null && (request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId);
    }

    // Matchs (Connexions établies)
    match /matches/{matchId} {
      // Un utilisateur peut lire ses matchs
      allow read: if request.auth != null && request.auth.uid in resource.data.users;
      // La création/mise à jour nécessite que l'utilisateur fasse partie du match
      allow write: if request.auth != null && request.auth.uid in request.resource.data.users;
    }

    // Messages de Chat
    match /chats/{chatId}/messages/{messageId} {
      // Permettre l'accès si l'ID du chat contient l'ID de l'utilisateur (ex: userId1_userId2)
      allow read, write: if request.auth != null && chatId.matches('.*' + request.auth.uid + '.*');
    }

    // Signalements (Reports)
    match /reports/{reportId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.reporterId;
      allow read, update, delete: if request.auth != null && request.auth.token.email == "bambasarr012@gmail.com";
    }
  }
}
